{
  "name": "activity-monitor",
  "version": "0.1.0",
  "description": "",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "license": "MIT",
  "author": "",
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.9"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint",
    "build": "bun run check && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "dist": "bun run build && electron-builder",
    "dist:dir": "bun run build && electron-builder --dir",
    "dist:mac": "bun run build && electron-builder --mac",
    "dist:win": "bun run build && electron-builder --win",
    "dist:linux": "bun run build && electron-builder --linux",
    "dist:all": "bun run build && electron-builder -mwl",
    "clean": "rimraf dist out"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/playfair-display": "^5.2.8",
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.3",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@tailwindcss/vite": "^4.2.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
